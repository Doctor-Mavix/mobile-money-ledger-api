# Values read by docker-compose.prod.yml. Copy to .env.prod, fill it in, keep it out of git.
#
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Only what the deployment needs is here; everything else keeps the default from
# src/core/config/env.ts, which is documented variable by variable in .env.example.

# Port nginx publishes on the host.
HTTP_PORT=8080

POSTGRES_PASSWORD=change-me

# Required in production: an empty list would accept every origin, and "*" is refused.
CORS_ORIGINS=https://app.example.org

# Three different secrets, 32 characters minimum. Booting is refused if any two are equal.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Encrypts the TOTP secrets at rest. Back it up with the database: losing it means every user
# with two-factor authentication has to enrol again.
MFA_SECRET_KEY=

# The API reference is served behind HTTP Basic. In production a password is mandatory:
# set DOCS_ENABLED=false to serve nothing at all instead.
DOCS_ENABLED=true
DOCS_USER=docs
DOCS_PASSWORD=

LOG_LEVEL=info

# Leave empty to keep the no-op mailer and the no-op storage, which log instead of sending.
SMTP_HOST=
SMTP_PORT=587
MAIL_FROM=OrangCode <no-reply@example.org>
S3_ENDPOINT=
S3_BUCKET=orangcode-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
