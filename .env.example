# Copy to .env and adjust. Every variable is validated at boot: an invalid value stops the process.

# --- Application -------------------------------------------------------------
# development | test | production
NODE_ENV=development
APP_NAME=fintech
APP_VERSION=0.1.0
# Mount path shared by every business module. Must start with "/".
API_PREFIX=/api/v1
# Comma separated module names, or "*" for all of them.
MODULES_ENABLED=*

# --- HTTP server -------------------------------------------------------------
HOST=0.0.0.0
PORT=3020
# Express "trust proxy": loopback | true | false | a hop count | an IP list.
# Behind a load balancer, set it so req.ip reflects the real client.
TRUST_PROXY=loopback
# Maximum request body size: <number>b | <number>kb | <number>mb
BODY_LIMIT=1mb

# --- Database ----------------------------------------------------------------
# PostgreSQL only. The template this project comes from also supports MongoDB; money moves
# inside transactions the database itself has to guarantee, so that half was removed. Any
# other value is refused at boot rather than failing on the first query.
DB_PROVIDER=postgres
# Port 5434, not 5432: the dev stack shifts its host ports so it can run next to the
# other OrangCode projects.
DATABASE_URL=postgresql://fintech:fintech@127.0.0.1:5434/fintech
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000
# Queries slower than this are logged at warn level.
DB_SLOW_QUERY_MS=200

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6383
# Namespaces every key so several apps can share one Redis instance.
REDIS_KEY_PREFIX=fintech:

# --- Rate limiting -----------------------------------------------------------
# Backed by Redis so the quota is shared across every instance of the app.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Background jobs (BullMQ, on the Redis above) ------------------------------
# false runs every job inline, which is fine in tests and wrong in production:
# a slow email would then block the request that triggered it.
QUEUE_ENABLED=true
QUEUE_PREFIX=jobs
QUEUE_CONCURRENCY=5
# Attempts per job before it lands in the failed set, with exponential backoff.
QUEUE_ATTEMPTS=3

# --- Email -------------------------------------------------------------------
# Leave SMTP_HOST empty to select the no-op mailer, which logs instead of sending.
# The dev stack ships Mailpit: SMTP on 1028, web interface on http://localhost:8028
SMTP_HOST=127.0.0.1
SMTP_PORT=1028
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Fintech <no-reply@fintech.local>

# --- Object storage (S3 compatible) -------------------------------------------
# Leave S3_ENDPOINT empty to disable uploads. The dev stack ships MinIO:
# API on 9030, web console on http://localhost:9031 (fintech / fintech-secret).
S3_ENDPOINT=http://127.0.0.1:9030
S3_REGION=us-east-1
S3_BUCKET=fintech-media
S3_ACCESS_KEY=fintech
S3_SECRET_KEY=fintech-secret
# MinIO needs path-style addressing; set false for AWS S3.
S3_FORCE_PATH_STYLE=true
# Lifetime of the presigned download URLs handed to clients.
S3_URL_EXPIRY_SECONDS=3600
MEDIA_MAX_UPLOAD_BYTES=10485760

# --- Realtime (Socket.IO) ------------------------------------------------------
# Broadcast goes through the Redis adapter, so it survives several app instances.
REALTIME_ENABLED=true
REALTIME_PATH=/realtime

# --- API reference (OpenAPI + Swagger UI) --------------------------------------
# Generated from the routes and their Zod schemas at boot, so it cannot drift from the code.
# The UI is served from the application itself, never from a CDN.
DOCS_ENABLED=true
DOCS_PATH=/docs
# HTTP Basic. An empty password leaves the reference open, which is refused in production:
# either set a password there, or set DOCS_ENABLED=false.
DOCS_USER=docs
DOCS_PASSWORD=

# --- Localisation --------------------------------------------------------------
# fr | en — resolved per request from Accept-Language, this is the fallback.
DEFAULT_LOCALE=fr
# ISO 3166-1 alpha-2. Lets a local number such as 97000000 be read as +22997000000.
DEFAULT_COUNTRY_CODE=BJ

# --- Security ----------------------------------------------------------------
# Comma separated origin whitelist. REQUIRED in production, and "*" is refused there.
# In development, any localhost origin is accepted on top of this list.
CORS_ORIGINS=http://localhost:5173

# --- Logging -----------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human readable output. Keep false in production so logs stay parsable JSON.
LOG_PRETTY=true

# --- Timeouts (milliseconds) -------------------------------------------------
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=65000
# Delay granted to in-flight requests on SIGTERM before the process is killed.
SHUTDOWN_TIMEOUT_MS=15000

# --- Authentication ----------------------------------------------------------
# REQUIRED, at least 32 characters, and the two must differ: one leaked access secret must
# not also mint refresh tokens. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Encrypts the TOTP secrets at rest, and must differ from the two above. A TOTP secret cannot be
# hashed — the server has to reproduce the code — so this key is what stands between a stolen
# database and every second factor. Rotating it forces everyone to enrol again.
MFA_SECRET_KEY=
JWT_ISSUER=fintech
JWT_AUDIENCE=fintech-api
# Short on purpose: the access token cannot be revoked, so it must expire on its own.
ACCESS_TOKEN_TTL_SECONDS=900
# Sliding: the TTL is reset on every rotation, so an active device is never signed out.
REFRESH_TOKEN_TTL_SECONDS=2592000
MFA_CHALLENGE_TTL_SECONDS=300

# --- Password policy ---------------------------------------------------------
PASSWORD_MIN_LENGTH=12
# argon2id cost. Raising these does not invalidate existing hashes.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# --- Login throttling --------------------------------------------------------
# Failures are counted per account AND per IP; the delay doubles past the threshold.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_BASE_SECONDS=30
LOGIN_LOCKOUT_MAX_SECONDS=3600
